# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=4000

# --- Database (hosted Postgres: Neon or Supabase) ---
# DATABASE_URL = the POOLED connection string (used by the running app).
# DIRECT_URL   = the DIRECT connection string (used by prisma migrate).
#
# Supabase: DATABASE_URL uses the pooler host on port 6543 with
#   ?pgbouncer=true&connection_limit=1 ; DIRECT_URL uses port 5432.
# Neon: DATABASE_URL uses the "-pooler" host ; DIRECT_URL uses the direct host.
# Both usually need ?sslmode=require.
DATABASE_URL=

# --- Auth (JWT) ---
# Use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d